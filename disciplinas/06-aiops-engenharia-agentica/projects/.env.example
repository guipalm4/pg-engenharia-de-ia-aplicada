# Copie para .env na RAIZ de projects/ (um único arquivo serve todos os projetos:
# core/llm_config.py usa load_dotenv(), que sobe a árvore de diretórios até achar).
#
#   cp .env.example .env
#
# Chave da Groq: https://console.groq.com/keys
GROQ_API_KEY=

# Modelo usado por todas as aulas (default: groq/qwen/qwen3.6-27b).
# Descomente só se o default sair do catálogo da Groq ou se quiser comparar:
#   GROQ_MODEL=groq/openai/gpt-oss-120b     # "Production", porém estoura o
#                                           # teto de tokens/min nas aulas 002 e 004
#   GROQ_MODEL=groq/openai/gpt-oss-20b      # antigo padrão; exige a linha abaixo
#   GROQ_REASONING_EFFORT=medium            # só para a família gpt-oss; o qwen ignora
#
# Teto de saída por chamada (default: 2560). A Groq RESERVA esse valor do orçamento
# de tokens (por minuto E por dia), então subir isso reduz quantas chamadas cabem
# antes do rate limit. Só mexa se alguma resposta vier truncada.
#   GROQ_MAX_TOKENS=2560

# --- Aula 003 (opcional) -----------------------------------------------------
# Contextos kubectl autorizados a receber `kubectl apply`, em CSV de globs.
# Deixe em branco para usar o default seguro, que já cobre os clusters locais:
#   kind-*, k3d-*, minikube, docker-desktop, rancher-desktop, orbstack, colima
# K8S_ALLOWED_CONTEXTS=kind-*,meu-cluster-de-lab
